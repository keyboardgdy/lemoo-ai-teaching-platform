{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lemoo.dev/jobs/job-result.v1.schema.json",
  "title": "Stage 1A Job result v1",
  "x-lemoo": {
    "status": "frozen",
    "scope": "stage-1a-simulator-first",
    "production_supported": false
  },
  "type": "object",
  "required": ["schema", "job_id", "organization_id", "state", "completed_at", "result", "error", "production_supported"],
  "properties": {
    "schema": { "const": "lemoo.job.result.v1" },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "organization_id": { "type": "string", "pattern": "^ORG-SIM-[AB]$" },
    "state": { "enum": ["succeeded", "failed", "timed_out", "cancelled", "dead_letter"] },
    "completed_at": { "type": "string", "format": "date-time" },
    "result": { "type": "object", "maxProperties": 4 },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://schemas.lemoo.dev/jobs/job-error.v1.schema.json" }
      ]
    },
    "production_supported": { "const": false }
  },
  "additionalProperties": false
}
