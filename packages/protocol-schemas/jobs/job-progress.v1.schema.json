{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lemoo.dev/jobs/job-progress.v1.schema.json",
  "title": "Stage 1A Job progress v1",
  "x-lemoo": {
    "status": "frozen",
    "scope": "stage-1a-simulator-first",
    "production_supported": false
  },
  "type": "object",
  "required": ["schema", "job_id", "organization_id", "state", "progress_percent", "attempt", "observed_at", "production_supported"],
  "properties": {
    "schema": { "const": "lemoo.job.progress.v1" },
    "job_id": { "$ref": "#/$defs/uuid" },
    "organization_id": { "type": "string", "pattern": "^ORG-SIM-[AB]$" },
    "state": { "enum": ["queued", "running", "retrying"] },
    "progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
    "observed_at": { "type": "string", "format": "date-time" },
    "production_supported": { "const": false }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
