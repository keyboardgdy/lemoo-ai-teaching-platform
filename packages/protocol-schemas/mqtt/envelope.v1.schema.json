{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lemoo.dev/mqtt/envelope.v1.schema.json",
  "title": "Lemoo MQTT envelope v1",
  "x-lemoo": {
    "status": "frozen",
    "scope": "stage-1a-simulator-first",
    "production_supported": false
  },
  "type": "object",
  "required": [
    "schema",
    "message_id",
    "device_id",
    "boot_id",
    "sequence",
    "sent_at",
    "firmware_version",
    "is_physical_hardware",
    "production_supported",
    "payload"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^lemoo\\.mqtt\\.[a-z-]+\\.v1$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^SIM-[AB]-00[1-3]$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^boot-[0-9]{4}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "firmware_version": {
      "const": "sim-1"
    },
    "is_physical_hardware": {
      "const": false
    },
    "production_supported": {
      "const": false
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
