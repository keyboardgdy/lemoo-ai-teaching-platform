{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	@backend path /api/* /health/*
	handle @backend {
		reverse_proxy {$LEMOO_API_UPSTREAM:http://api:8000}
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
